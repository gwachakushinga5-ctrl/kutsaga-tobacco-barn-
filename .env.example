# Leave blank to call the API through the Vite dev/preview proxy (recommended; avoids CORS).
# Or set the full deployed base URL, e.g. https://kutsaga-app.<region>.azurecontainerapps.io
VITE_API_BASE_URL=

# Optional: a platform API key sent as the X-API-Key header (dev convenience).
# Leave blank to sign in with username/password instead.
VITE_API_KEY=
