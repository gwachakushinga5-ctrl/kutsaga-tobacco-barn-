# Leave unset/blank to use same-origin API calls (Vite dev/preview proxy or Vercel rewrites).
# Only set this if serving dist/ without a proxy:
# VITE_API_BASE_URL=https://kutsaga-app.<region>.azurecontainerapps.io
VITE_API_BASE_URL=

# Optional: a platform API key sent as the X-API-Key header (dev convenience).
# Leave blank to sign in with username/password instead.
VITE_API_KEY=
