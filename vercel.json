{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kutsaga-app.livelybush-d14e9c76.switzerlandnorth.azurecontainerapps.io/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://kutsaga-app.livelybush-d14e9c76.switzerlandnorth.azurecontainerapps.io/health/:path*"
    }
  ]
}
