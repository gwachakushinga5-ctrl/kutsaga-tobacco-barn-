{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm ci && npm run build && node scripts/vercel-build.mjs",
  "outputDirectory": ".vercel/output/static",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kutsaga-app.livelybush-d14e9c76.switzerlandnorth.azurecontainerapps.io/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://kutsaga-app.livelybush-d14e9c76.switzerlandnorth.azurecontainerapps.io/health/:path*"
    }
  ]
}
